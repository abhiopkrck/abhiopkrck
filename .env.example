# Vercel server-side environment variables only. Never put these in VITE_* variables.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-16-character-google-app-password
CONTACT_FROM_EMAIL=your-sender@gmail.com
CONTACT_TO_EMAIL=your-inbox@gmail.com
